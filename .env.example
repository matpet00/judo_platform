# SQLite (volitelné; výchozí je sqlite+aiosqlite:///./judo.db)
# DATABASE_URL=sqlite+aiosqlite:///./judo.db

# Bezpečnost (volitelné pro dev)
# JWT_SECRET=dev-jwt-change-me
# PIN_PEPPER=dev-pin-pepper-change-me
# ENABLE_API_DOCS=true
# ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Výchozí PIN trenérů bez pin_hash v DB: 1234 (nastaví se při startu)

# SMTP — povinné pro POST /mail/parents (jinak 503)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
