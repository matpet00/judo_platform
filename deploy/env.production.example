# Production — zkopíruj na /opt/judo/.env (install.sh to udělá automaticky)

DATABASE_URL=sqlite+aiosqlite:////var/lib/judo/judo.db
UPLOAD_DIR=/var/lib/judo/uploads

# Vygeneruj silné hodnoty (install.sh je doplní, pokud chybí)
API_WRITE_KEY=
JWT_SECRET=
PIN_PEPPER=

# Změň před ostrým provozem
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Veřejná URL frontendu (čárkou oddělené; přesně včetně http/https, bez lomítka na konci)
# Příklad jen s IP:  ALLOWED_ORIGINS=http://123.45.67.89
# S doménou:         ALLOWED_ORIGINS=https://judo.tvujklub.cz
ALLOWED_ORIGINS=

# SMTP (volitelné — bez toho nefunguje odesílání e-mailů rodičům)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_USE_TLS=true
